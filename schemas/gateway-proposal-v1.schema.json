{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-native.dev/schemas/gateway-proposal-v1.schema.json",
  "title": "Agent Native Gateway Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_id",
    "service_name",
    "service_version",
    "operation_name",
    "method",
    "resource",
    "inputs",
    "required_capability",
    "effects",
    "effect_mode",
    "candidate_sha256",
    "proposal_sha256",
    "no_apply"
  ],
  "properties": {
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "service_name": {
      "type": "string",
      "minLength": 1
    },
    "service_version": {
      "type": "string",
      "minLength": 1
    },
    "operation_name": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "resource": {
      "type": "string",
      "pattern": "^/"
    },
    "inputs": {
      "type": "object"
    },
    "required_capability": {
      "type": "string",
      "minLength": 1
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effect_mode": {
      "enum": [
        "read",
        "write"
      ]
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "no_apply": {
      "const": true
    }
  }
}
