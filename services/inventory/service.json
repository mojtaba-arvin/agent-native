{
  "schema_version": 2,
  "service_id": "inventory",
  "service_name": "Inventory",
  "version": "1",
  "source": "service.an",
  "handlers": {
    "get_stock": {
      "handler_id": "crud.read_by_field",
      "config": {
        "resource": "stock",
        "field": "warehouse_id",
        "input": "warehouse_id"
      }
    },
    "create_stock": {
      "handler_id": "crud.create",
      "config": {
        "resource": "stock",
        "input_fields": [
          "sku",
          "quantity"
        ]
      }
    },
    "update_stock": {
      "handler_id": "crud.update",
      "config": {
        "resource": "stock",
        "key_input": "sku",
        "input_fields": [
          "quantity"
        ]
      }
    },
    "delete_stock": {
      "handler_id": "crud.delete",
      "config": {
        "resource": "stock",
        "key_input": "sku"
      }
    },
    "publish_stock_event": {
      "handler_id": "events.publish",
      "config": {
        "event_type": "stock.changed",
        "input_fields": [
          "sku",
          "quantity"
        ]
      }
    }
  },
  "policy": "policy.json"
}
