{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Native pilot candidate artifact",
  "description": "The final proposal artifact returned by the agent. This schema defines format only; acceptance is performed by a separate trusted evaluator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "service_id",
    "base_revision",
    "change_set_id",
    "ir"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "const": "pilot-catalog-add-readonly-operation"
    },
    "service_id": {
      "const": "catalog"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "change_set_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ir": {
      "$ref": "#/$defs/service_ir"
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "path",
            "query",
            "body",
            "header"
          ]
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "method",
        "path",
        "input",
        "output",
        "errors",
        "validation",
        "effects",
        "capability"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capability": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service_ir": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ir_version",
        "service",
        "types",
        "operations"
      ],
      "properties": {
        "ir_version": {
          "const": 1
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "const": "Catalog"
            },
            "version": {
              "const": "1"
            }
          }
        },
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "fields"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/field"
                },
                "minItems": 1
              }
            }
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          },
          "minItems": 1
        }
      }
    }
  }
}
