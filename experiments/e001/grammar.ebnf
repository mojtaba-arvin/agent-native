(* E-001 prototype grammar; intentionally small and provisional. *)
service       = "service", identifier, "{", version, { operation }, "}" ;
version       = "version", ":", string, ";" ;
operation     = "operation", identifier, "{",
                method, path, input, output, effects, capability, "}" ;
method        = "method", ":", http_method, ";" ;
path          = "path", ":", string, ";" ;
input         = "input", "{", { input_field }, "}" ;
input_field   = identifier, ":", identifier, "from", input_source, ";" ;
output        = "output", ":", identifier, ";" ;
effects       = "effects", ":", "[", [ identifier, { ",", identifier } ], "]", ";" ;
capability    = "capability", ":", string, ";" ;
http_method   = "GET" | "POST" | "PUT" | "PATCH" | "DELETE" ;
input_source  = "path" | "query" | "body" | "header" ;
identifier    = letter, { letter | digit | "_" | "." | "-" } ;
string        = '"', { escaped_char | ? any non-quote, non-backslash character ? }, '"' ;
