{
  "ir_version": 1,
  "service": { "name": "Catalog", "version": "1" },
  "operations": [
    {
      "name": "create_item",
      "method": "POST",
      "path": "/items",
      "input": [{ "name": "name", "type": "String", "source": "body" }],
      "output": "Item",
      "effects": ["repository.write"],
      "capability": "items.create"
    },
    {
      "name": "get_item",
      "method": "GET",
      "path": "/items/{id}",
      "input": [{ "name": "id", "type": "UUID", "source": "path" }],
      "output": "Item",
      "effects": ["repository.read"],
      "capability": "items.read"
    }
  ]
}
