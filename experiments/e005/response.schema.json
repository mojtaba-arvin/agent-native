{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "ok", "result", "diagnostics", "next_actions"],
  "properties": {
    "protocol_version": {"const": "0.1"},
    "request_id": {"type": "string"},
    "ok": {"type": "boolean"},
    "result": {},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "source_span", "fix_hint"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "source_span": {"type": ["object", "null"]},
          "fix_hint": {"type": ["string", "null"]}
        }
      }
    },
    "next_actions": {"type": "array", "items": {"type": "string"}}
  }
}
