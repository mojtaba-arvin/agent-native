      "reason": "The CI smoke matrix is not decision-grade; representative workloads and controlled dedicated-machine measurements are outstanding."
    },
    {
      "id": "D-0009",
      "topic": "concurrency_and_failure_semantics",
      "status": "open",
      "value": "The E-003 reference model is provisional and does not yet define production semantics.",
      "evidence": [
        "Bounded admission and concurrency tests",
        "Deadlines, cancellation, retries, worker crash, idempotency, and shutdown tests"
      ],
      "reason": "Durability, distributed atomicity, fairness, leases, clock skew, and multi-process fault injection remain unresolved."
