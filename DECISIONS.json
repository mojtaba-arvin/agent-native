      "topic": "product_identity",
      "status": "decided",
      "value": "Build a new backend framework with its own programming model and runtime semantics.",
      "evidence": "Explicit project requirement.",
      "constraints": [
        "not_a_wrapper",
        "not_an_adapter",
        "not_a_framework_manager",
        "not_a_codegen_layer_for_existing_backend_frameworks"
      ]
    },
    {
